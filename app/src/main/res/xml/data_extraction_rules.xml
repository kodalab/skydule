<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy for cloud backup and device-to-device transfer. Settings are restored; calendar choices in them are stored by stable key, not local id. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="skydule_reminders.xml" />
        <exclude domain="sharedpref" path="skydule_day_icon.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="skydule_reminders.xml" />
        <exclude domain="sharedpref" path="skydule_day_icon.xml" />
    </device-transfer>
</data-extraction-rules>
