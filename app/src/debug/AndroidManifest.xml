<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Personal build only: lets the weather pill find and open Gradient Weather on Android 11+. -->
    <queries>
        <package android:name="com.subtlesignals.gradientweather" />
    </queries>

    <application>
        <!-- Debug builds only: shows a crash's stack trace on screen (see CrashReportActivity). -->
        <activity
            android:name="com.kodalabs.skydule.debug.CrashReportActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":crash"
            android:theme="@android:style/Theme.DeviceDefault.Light" />
    </application>
</manifest>
