<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same policy for cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gradule_reminders.xml" />
        <exclude domain="sharedpref" path="gradule_day_icon.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gradule_reminders.xml" />
        <exclude domain="sharedpref" path="gradule_day_icon.xml" />
    </device-transfer>
</data-extraction-rules>
